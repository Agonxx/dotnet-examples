{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    // ATENÇÃO: chave de MENTIRA, só para este exemplo. Em um projeto real ela
    // nunca vai para o Git: use user-secrets, variável de ambiente ou um cofre.
    // Para HMAC-SHA256 a chave precisa ter pelo menos 32 caracteres (256 bits).
    "Issuer": "dotnet-examples",
    "Audience": "dotnet-examples-clients",
    "Key": "chave-de-mentira-so-para-o-exemplo-1234567890",
    "ExpirationMinutes": 30
  }
}
